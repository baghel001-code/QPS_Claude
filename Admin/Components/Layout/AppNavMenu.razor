@using Admin.Navigation
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using MudBlazor
@inject AppMenu Menu

@* Left menu: Home, then the groups this user gets from AppMenu (role IDs + modules), then Sign out. *@
<AuthorizeView>
    <Authorized>
        @{ var groups = Menu.For(context.User); }
        <nav class="qps-nav" aria-label="Main menu">
            <MudNavMenu Color="Color.Primary" Class="qps-navmenu">
                <MudNavLink Href="/" Icon="@Icons.Material.Outlined.Home" Match="NavLinkMatch.All">Home</MudNavLink>
                @foreach (var group in groups)
                {
                    @* Short menus start expanded; long ones collapsed so the drawer stays scannable. *@
                    <NavNode Node="group" Expanded="@(groups.Count <= 3)" />
                }
            </MudNavMenu>
            <div class="qps-nav-foot">
                <MudNavMenu Class="qps-navmenu">
                    <MudNavLink Icon="@Icons.Material.Outlined.Logout" OnClick="@(() => SignOut.InvokeAsync())">Sign out</MudNavLink>
                </MudNavMenu>
            </div>
        </nav>
    </Authorized>
</AuthorizeView>

@code {
    /// <summary>Set by DashboardLayout; posts the sign-out form.</summary>
    [Parameter] public EventCallback SignOut { get; set; }
}
