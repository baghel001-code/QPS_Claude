@using Admin.Navigation
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using MudBlazor
@inject AppMenu Menu

@* Left menu: Home, then the groups this user may see (AppMenu: auth.Menu + permissions), then Sign out. *@
<AuthorizeView>
    <Authorized>
        <nav class="qps-nav" aria-label="Main menu">
            <MudNavMenu Color="Color.Primary" Class="qps-navmenu">
                <MudNavLink Href="/" Icon="@Icons.Material.Outlined.Home" Match="NavLinkMatch.All">Home</MudNavLink>
                @foreach (var group in _groups)
                {
                    @* Short menus start expanded; long ones collapsed so the drawer stays scannable. *@
                    <NavNode Node="group" Expanded="@(_groups.Count <= 3)" />
                }
            </MudNavMenu>
            <div class="qps-nav-foot">
                <MudNavMenu Class="qps-navmenu">
                    <MudNavLink Icon="@Icons.Material.Outlined.Logout" OnClick="@(() => SignOut.InvokeAsync())">Sign out</MudNavLink>
                </MudNavMenu>
            </div>
        </nav>
    </Authorized>
</AuthorizeView>

@code {
    /// <summary>Set by DashboardLayout; posts the sign-out form.</summary>
    [Parameter] public EventCallback SignOut { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<MenuNode> _groups = [];

    // Runs on every navigation (the layout re-renders), so access changes show up without a reload.
    // Cheap: AccessService caches permissions and the menu.
    protected override async Task OnParametersSetAsync()
    {
        if (AuthState is null)
            return;
        var user = (await AuthState).User;
        _groups = user.Identity?.IsAuthenticated == true ? await Menu.ForAsync(user) : [];
    }
}
