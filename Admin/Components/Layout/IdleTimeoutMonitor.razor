@using Admin.Services
@using Application.Interfaces.V1.User
@using Application.Services.User
@using Domain.Entities.AppSettings
@using Domain.Enums
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject IUserActivityState Activity
@inject ISessionInvalidationState InvalidationState
@inject AppConfigurationSettings Settings

@* Place once in MainLayout.razor. Renders nothing until the warning is due. *@
@if (_showWarning)
{
    <MudOverlay Visible="true" DarkBackground="true" ZIndex="10000">
        <MudPaper Class="pa-6" Elevation="8" Style="max-width:420px">
            <MudText Typo="Typo.h6" Class="mb-2">Session about to expire</MudText>
            <MudText Class="mb-4">
                You have been inactive for a while. For your security you will be logged out in
                <b>@_secondsLeft</b> seconds.
            </MudText>
            <div class="d-flex justify-end gap-2">
                <MudButton Variant="Variant.Text" OnClick="LogoutNow">Log out</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StaySignedIn">Stay signed in</MudButton>
            </div>
        </MudPaper>
    </MudOverlay>
}

@code {
    private const string LogoutUrl = "/Account/User-Logout";
    private const string KeepAliveUrl = "api/session/keepalive";
    private const string ScriptUrl = "js/idle-timeout.js";

    private static readonly TimeSpan WarningWindow = TimeSpan.FromSeconds(60);
    private static readonly TimeSpan ReportThrottle = TimeSpan.FromSeconds(15);
    private static readonly TimeSpan LogoutRetryDelay = TimeSpan.FromSeconds(5);

    private readonly CancellationTokenSource _cts = new();
    private TimeSpan _idleTimeout;
    private TimeSpan _keepAliveInterval;
    private PeriodicTimer? _timer;
    private DotNetObjectReference<IdleTimeoutMonitor>? _selfRef;
    private IJSObjectReference? _module;
    private IJSObjectReference? _tracker;
    private bool _isAuthenticated;
    private bool _showWarning;
    private int _secondsLeft;
    private DateTimeOffset? _logoutRequestedAt;

    protected override async Task OnInitializedAsync()
    {
        _idleTimeout = TimeSpan.FromMinutes(Math.Max(Settings.MaxSessionTime, 1));

        // Must stay well under half the cookie lifetime so sliding expiration always renews.
        _keepAliveInterval = TimeSpan.FromTicks(Math.Clamp(_idleTimeout.Ticks / 4,
            TimeSpan.FromSeconds(30).Ticks, TimeSpan.FromMinutes(5).Ticks));

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAuthenticated = state.User.Identity?.IsAuthenticated == true;
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // OnAfterRender only runs once the circuit is interactive (never during prerender).
        if (!firstRender || !_isAuthenticated)
            return;

        Activity.Touch();
        _ = RunTimerAsync();

        try
        {
            _selfRef = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", Nav.ToAbsoluteUri(ScriptUrl).ToString());
            _tracker = await _module.InvokeAsync<IJSObjectReference>("start", _selfRef, new
            {
                reportThrottleMs = (int)ReportThrottle.TotalMilliseconds,
                keepAliveUrl = Nav.ToAbsoluteUri(KeepAliveUrl).ToString(),
                keepAliveIntervalMs = (int)_keepAliveInterval.TotalMilliseconds
            });
        }
        catch (JSDisconnectedException)
        {
            // Circuit went away while starting; DisposeAsync cleans up.
        }
    }

    [JSInvokable]
    public void ReportActivity()
    {
        if (_logoutRequestedAt is not null)
            return;

        Activity.Touch();
        if (_showWarning)
        {
            _showWarning = false;
            StateHasChanged();
        }
    }

    private async Task RunTimerAsync()
    {
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await _timer.WaitForNextTickAsync(_cts.Token))
                await InvokeAsync(CheckIdle);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void CheckIdle()
    {
        if (_logoutRequestedAt is { } requestedAt)
        {
            // A navigation sent while the circuit was disconnected is lost; retry until it lands.
            if (DateTimeOffset.UtcNow - requestedAt >= LogoutRetryDelay)
                Logout(idle: true);
            return;
        }

        var remaining = _idleTimeout - Activity.IdleFor;
        if (remaining <= TimeSpan.Zero)
        {
            Logout(idle: true);
            return;
        }

        var show = remaining <= WarningWindow;
        var secondsLeft = (int)Math.Ceiling(remaining.TotalSeconds);
        if (show != _showWarning || (show && secondsLeft != _secondsLeft))
        {
            _showWarning = show;
            _secondsLeft = secondsLeft;
            StateHasChanged();
        }
    }

    private void StaySignedIn()
    {
        Activity.Touch();
        _showWarning = false;
    }

    private void LogoutNow() => Logout(idle: false);

    private void Logout(bool idle)
    {
        _logoutRequestedAt = DateTimeOffset.UtcNow;
        _showWarning = false;
        if (idle)
            InvalidationState.Reason = SessionInvalidReason.IdleTimeout;

        // forceLoad = true so the logout endpoint runs over HTTP and clears the auth cookie.
        // Without it the circuit is anonymous but F5 would sign the user straight back in.
        Nav.NavigateTo(idle ? $"{LogoutUrl}?reason=idle" : LogoutUrl, forceLoad: true);
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        _ = InvokeAsync(async () =>
        {
            var state = await task;
            // The server-side revalidation (CustomRevalidatingAuthenticationStateProvider) caught
            // the idle timeout first; finish the job by clearing the cookie.
            if (state.User.Identity?.IsAuthenticated != true
                && InvalidationState.Reason == SessionInvalidReason.IdleTimeout
                && _logoutRequestedAt is null)
            {
                Logout(idle: true);
            }
        });
    }

    public async ValueTask DisposeAsync()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        _cts.Cancel();
        _timer?.Dispose();

        try
        {
            if (_tracker is not null)
            {
                await _tracker.InvokeVoidAsync("dispose");
                await _tracker.DisposeAsync();
            }
            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }

        _selfRef?.Dispose();
        _cts.Dispose();
    }
}
