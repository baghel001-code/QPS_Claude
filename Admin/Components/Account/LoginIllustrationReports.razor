@* Slide 3 art: a QC report screen with pass rate, weekly bars and approved items. Styled by wwwroot/css/auth.css. *@
<svg class="qps-art" viewBox="0 0 480 360" role="img" aria-label="QC report screen showing pass rate, weekly inspections and approvals">
    <ellipse cx="240" cy="330" rx="210" ry="16" class="a-shadow" />

    <!-- screen -->
    <rect x="60" y="44" width="360" height="236" rx="14" class="a-screen" />
    <rect x="74" y="58" width="332" height="208" rx="8" class="a-paper" />
    <rect x="210" y="280" width="60" height="30" class="a-stand" />
    <rect x="170" y="308" width="140" height="10" rx="5" class="a-stand" />

    <!-- header -->
    <rect x="90" y="74" width="90" height="8" rx="4" class="a-ink" />
    <rect x="318" y="72" width="72" height="14" rx="7" class="a-pill" />
    <text x="354" y="82" text-anchor="middle" class="a-pill-text">THIS WEEK</text>

    <!-- pass-rate ring: 94% of the circle -->
    <circle cx="140" cy="160" r="42" class="a-ring-bg" />
    <circle cx="140" cy="160" r="42" class="a-ring-val" pathLength="100" stroke-dasharray="94 100" transform="rotate(-90 140 160)" />
    <text x="140" y="160" text-anchor="middle" class="a-big">94%</text>
    <text x="140" y="174" text-anchor="middle" class="a-small">QC pass</text>

    <!-- weekly bars -->
    <g class="a-bars">
        <rect x="214" y="170" width="18" height="50" rx="3" class="a-bar" />
        <rect x="240" y="150" width="18" height="70" rx="3" class="a-bar" />
        <rect x="266" y="160" width="18" height="60" rx="3" class="a-bar" />
        <rect x="292" y="126" width="18" height="94" rx="3" class="a-bar hi" />
        <rect x="318" y="140" width="18" height="80" rx="3" class="a-bar" />
        <rect x="344" y="118" width="18" height="102" rx="3" class="a-bar" />
        <rect x="370" y="134" width="18" height="86" rx="3" class="a-bar" />
    </g>
    <rect x="206" y="220" width="190" height="2" class="a-line" />
    <rect x="90" y="236" width="300" height="1" class="a-line" />
    <circle cx="98" cy="252" r="6" class="a-ok" />
    <rect x="112" y="249" width="90" height="6" rx="3" class="a-line" />
    <circle cx="234" cy="252" r="6" class="a-ok" />
    <rect x="248" y="249" width="70" height="6" rx="3" class="a-line" />

    <!-- approval badge -->
    <g class="a-float">
        <rect x="330" y="206" width="120" height="58" rx="12" class="a-paper a-card-shadow" />
        <circle cx="356" cy="235" r="14" class="a-ok" /><path d="M349 235 l5 5 l9 -10" class="a-tick" />
        <rect x="378" y="224" width="58" height="7" rx="3.5" class="a-ink" />
        <rect x="378" y="238" width="40" height="6" rx="3" class="a-line" />
    </g>

    <circle cx="30" cy="100" r="3" class="a-dot" />
    <circle cx="452" cy="60" r="4" class="a-dot" />
</svg>
