@* Slide 2 art: a delivery truck arriving, an ASN slip and a booked inspection date. Styled by wwwroot/css/auth.css. *@
<svg class="qps-art" viewBox="0 0 480 360" role="img" aria-label="Delivery truck arriving with an ASN and a booked inspection date">
    <ellipse cx="240" cy="330" rx="210" ry="16" class="a-shadow" />
    <!-- road -->
    <rect x="20" y="318" width="440" height="4" rx="2" class="a-road" />
    <rect x="60" y="319" width="40" height="2" class="a-road-mark" />
    <rect x="160" y="319" width="40" height="2" class="a-road-mark" />
    <rect x="260" y="319" width="40" height="2" class="a-road-mark" />

    <!-- truck -->
    <g class="a-drive">
        <rect x="40" y="206" width="200" height="104" rx="8" class="a-truck-box" />
        <rect x="56" y="222" width="120" height="30" rx="4" class="a-truck-band" />
        <text x="116" y="243" text-anchor="middle" class="a-truck-text">QPS</text>
        <path d="M244 236 h52 l30 34 v40 h-82 z" class="a-truck-cab" />
        <path d="M256 246 h36 l20 24 h-56 z" class="a-truck-window" />
        <rect x="244" y="290" width="84" height="8" rx="3" class="a-truck-bumper" />
        <circle cx="92" cy="312" r="18" class="a-wheel" /><circle cx="92" cy="312" r="7" class="a-hub" />
        <circle cx="200" cy="312" r="18" class="a-wheel" /><circle cx="200" cy="312" r="7" class="a-hub" />
        <circle cx="290" cy="312" r="18" class="a-wheel" /><circle cx="290" cy="312" r="7" class="a-hub" />
    </g>

    <!-- ASN slip -->
    <g class="a-float">
        <rect x="70" y="60" width="130" height="118" rx="10" class="a-paper a-card-shadow" />
        <rect x="86" y="78" width="54" height="8" rx="4" class="a-ink" />
        <rect x="86" y="96" width="96" height="6" rx="3" class="a-line" />
        <rect x="86" y="110" width="80" height="6" rx="3" class="a-line" />
        <g class="a-ink">
            <rect x="86" y="132" width="3" height="28" /><rect x="92" y="132" width="1.5" height="28" />
            <rect x="96" y="132" width="4" height="28" /><rect x="103" y="132" width="1.5" height="28" />
            <rect x="107" y="132" width="3" height="28" /><rect x="113" y="132" width="1.5" height="28" />
            <rect x="117" y="132" width="4" height="28" /><rect x="124" y="132" width="2" height="28" />
            <rect x="129" y="132" width="3" height="28" /><rect x="135" y="132" width="1.5" height="28" />
        </g>
        <rect x="150" y="132" width="36" height="16" rx="8" class="a-pill" />
        <text x="168" y="144" text-anchor="middle" class="a-pill-text">ASN</text>
    </g>

    <!-- calendar with booked date -->
    <g class="a-float a-delay">
        <rect x="288" y="48" width="150" height="150" rx="12" class="a-paper a-card-shadow" />
        <rect x="288" y="48" width="150" height="34" rx="12" class="a-cal-head" />
        <rect x="288" y="66" width="150" height="16" class="a-cal-head" />
        <rect x="312" y="40" width="8" height="20" rx="4" class="a-clip" />
        <rect x="406" y="40" width="8" height="20" rx="4" class="a-clip" />
        <text x="363" y="71" text-anchor="middle" class="a-cal-title">INSPECTION</text>
        <g class="a-line">
            <rect x="304" y="96" width="18" height="14" rx="3" /><rect x="330" y="96" width="18" height="14" rx="3" />
            <rect x="356" y="96" width="18" height="14" rx="3" /><rect x="382" y="96" width="18" height="14" rx="3" />
            <rect x="408" y="96" width="18" height="14" rx="3" />
            <rect x="304" y="120" width="18" height="14" rx="3" /><rect x="330" y="120" width="18" height="14" rx="3" />
            <rect x="382" y="120" width="18" height="14" rx="3" /><rect x="408" y="120" width="18" height="14" rx="3" />
            <rect x="304" y="144" width="18" height="14" rx="3" /><rect x="330" y="144" width="18" height="14" rx="3" />
            <rect x="356" y="144" width="18" height="14" rx="3" /><rect x="382" y="144" width="18" height="14" rx="3" />
            <rect x="408" y="144" width="18" height="14" rx="3" />
        </g>
        <rect x="354" y="118" width="22" height="18" rx="4" class="a-booked" />
        <circle cx="420" cy="182" r="14" class="a-ok" /><path d="M413 182 l5 5 l9 -10" class="a-tick" />
    </g>

    <circle cx="240" cy="36" r="4" class="a-dot" />
    <circle cx="456" cy="240" r="3" class="a-dot" />
    <circle cx="28" cy="150" r="3" class="a-dot" />
</svg>
