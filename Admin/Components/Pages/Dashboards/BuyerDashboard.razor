@page "/BuyerDashboard"
@layout Admin.Components.Layout.DashboardLayout
@attribute [Authorize(Policy = AppPolicies.Buyer)]
@using Admin.Auth
@using Admin.Components.Dashboard
@using Microsoft.AspNetCore.Authorization
@using MudBlazor

<PageTitle>Buyer dashboard · QPS</PageTitle>

<DashboardHeader Title="Buyer dashboard" Subtitle="Samples to approve, inspections on your orders and incoming shipments.">
    <MudButton Href="/coming-soon?page=PPS%20approvals&path=%2FPPS" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Checkroom">Review PPS</MudButton>
</DashboardHeader>

<div class="qps-kpis">
    <KpiTile Label="Open purchase orders" Value="42" Note="₹3.8 Cr order value" Icon="@Icons.Material.Outlined.ReceiptLong" Tone="blue" />
    <KpiTile Label="PPS awaiting your approval" Value="5" Note="2 waiting over 3 days" Icon="@Icons.Material.Outlined.Checkroom" Tone="pink" />
    <KpiTile Label="Inspections scheduled" Value="11" Note="Next 7 days" Icon="@Icons.Material.Outlined.EventAvailable" Tone="amber" />
    <KpiTile Label="ASNs in transit" Value="8" Note="3 arriving today" Icon="@Icons.Material.Outlined.LocalShipping" Tone="green" />
</div>

<div class="qps-grid-2">
    <DashCard Title="Pre-production samples to approve">
        <div class="qps-table-wrap">
            <table class="qps-table">
                <thead><tr><th>Style</th><th>Vendor</th><th>Category</th><th>Submitted</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var r in Pps)
                    {
                        <tr><td class="num">@r.Style</td><td>@r.Vendor</td><td>@r.Category</td><td class="num">@r.Submitted</td><td><StatusChip Status="@r.Status" /></td></tr>
                    }
                </tbody>
            </table>
        </div>
    </DashCard>

    <DashCard Title="Arriving shipments">
        <Action><MudLink Href="/AsnReqList" Typo="Typo.body2">All ASNs</MudLink></Action>
        <ChildContent>
            <ul class="qps-list">
                <li><span><b>ASN 7700451</b><br /><small>Shree Balaji Garments · 18 cartons · Gurugram DC</small></span><StatusChip Status="In transit" /></li>
                <li><span><b>ASN 7700448</b><br /><small>Om Sai Textiles · 40 cartons · Bhiwandi DC</small></span><StatusChip Status="In transit" /></li>
                <li><span><b>ASN 7700440</b><br /><small>Sunrise Home Linen · 22 cartons · Gurugram DC</small></span><StatusChip Status="Delivered" /></li>
            </ul>
        </ChildContent>
    </DashCard>
</div>

@code {
    private sealed record Row(string Style, string Vendor, string Category, string Submitted, string Status);

    private static readonly Row[] Pps =
    [
        new("MS-24-1182", "Shree Balaji Garments", "Men's shirts", "25 Sep", "Awaiting approval"),
        new("KT-24-0931", "Kaveri Knitwear", "Kids' T-shirts", "26 Sep", "Awaiting approval"),
        new("WJ-24-0417", "Metro Denim Co.", "Women's jeans", "27 Sep", "Awaiting approval"),
        new("BS-24-0288", "Om Sai Textiles", "Bedsheets", "27 Sep", "Rework requested"),
        new("TW-24-0102", "Sunrise Home Linen", "Towels", "28 Sep", "Awaiting approval"),
    ];
}
