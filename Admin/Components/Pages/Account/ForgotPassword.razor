@page "/Account/Forgot-Password"
@layout Admin.Components.Layout.AuthLayout
@rendermode InteractiveServer
@attribute [AllowAnonymous]

@using System.ComponentModel.DataAnnotations
@using Admin.Auth
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Options
@using MudBlazor
@using static Microsoft.AspNetCore.Components.Web.RenderMode

@inject PasswordResetService Resets
@inject IOptions<AuthSettings> Settings
@inject ILogger<ForgotPassword> Logger

<PageTitle>Forgot password</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1">Forgot password</MudText>

@if (_sent)
{
    @* Same message whether or not the account exists, so this page can't be used to find accounts. *@
    <MudAlert Severity="Severity.Success" Class="my-4">
        If an account matches <b>@_submittedLogin</b>, we've sent a reset link to its e-mail address.
        The link expires in @Settings.Value.PasswordResetTokenMinutes minutes.
    </MudAlert>
    <MudLink Href="/Account/Login">Back to sign in</MudLink>
}
else
{
    <MudText Typo="Typo.body2" Class="mb-6 mud-text-secondary">
        Enter your username or e-mail and we'll send you a link to set a new password.
    </MudText>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4" role="alert">@_error</MudAlert>
    }

    <EditForm Model="_model" OnValidSubmit="SubmitAsync">
        <DataAnnotationsValidator />
        <MudTextField @bind-Value="_model.Login" For="@(() => _model.Login)"
                      Label="Username or e-mail" Variant="Variant.Outlined" Class="mb-6"
                      AutoFocus="true" Disabled="_busy" autocomplete="username" />
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                   Size="Size.Large" FullWidth="true" Disabled="_busy">
            @(_busy ? "Sending…" : "Send reset link")
        </MudButton>
    </EditForm>

    <div class="mt-4"><MudLink Href="/Account/Login" Typo="Typo.body2">Back to sign in</MudLink></div>
}

@code {
    private readonly ForgotModel _model = new();
    private string _submittedLogin = "";
    private bool _busy;
    private bool _sent;
    private string? _error;

    private async Task SubmitAsync()
    {
        if (_busy)
            return;
        _busy = true;
        _error = null;

        // Pad every request to the same minimum time, so "account exists" (which sends an
        // e-mail) isn't measurably slower than "no such account".
        var minimumDuration = Task.Delay(TimeSpan.FromSeconds(1));
        try
        {
            await Resets.RequestResetAsync(_model.Login);
            await minimumDuration;
            _submittedLogin = _model.Login.Trim();
            _sent = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Password reset request failed");
            await minimumDuration;
            _error = "We couldn't process the request right now. Please try again later.";
        }
        _busy = false;
    }

    private sealed class ForgotModel
    {
        [Required(ErrorMessage = "Enter your username or e-mail.")]
        [StringLength(256)]
        public string Login { get; set; } = "";
    }
}
