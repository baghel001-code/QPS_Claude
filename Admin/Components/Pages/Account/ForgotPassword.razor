@page "/Account/Forgot-Password"
@layout Admin.Components.Layout.AuthLayout
@rendermode InteractiveServer
@attribute [AllowAnonymous]

@using System.ComponentModel.DataAnnotations
@using Admin.Auth
@using Admin.Auth.Captcha
@using Admin.Components.Account
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Options
@using MudBlazor
@using static Microsoft.AspNetCore.Components.Web.RenderMode

@inject PasswordResetService Resets
@inject CaptchaService Captchas
@inject IOptions<AuthSettings> Settings
@inject ILogger<ForgotPassword> Logger

<PageTitle>Forgot password</PageTitle>

<div class="qps-eyebrow">Vendor account</div>
<MudText Typo="Typo.h5" Class="mb-1">Forgot password</MudText>

@if (_sent)
{
    @* Same message whether or not the account exists, so this page can't be used to find accounts. *@
    <MudAlert Severity="Severity.Success" Class="my-4">
        If an account matches <b>@_submittedLogin</b>, we've sent a reset link to its e-mail address.
        The link expires in @Settings.Value.PasswordResetTokenMinutes minutes.
    </MudAlert>
    <MudLink Href="/Account/Login?type=vendor">Back to vendor sign-in</MudLink>
}
else
{
    <MudText Typo="Typo.body2" Class="mb-6 mud-text-secondary">
        For vendor accounts. Enter your vendor code or e-mail and we'll send a link to set a new password.
        Employees: contact the IT helpdesk.
    </MudText>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4" role="alert">@_error</MudAlert>
    }

    <EditForm Model="_model" OnValidSubmit="SubmitAsync">
        <DataAnnotationsValidator />
        <MudTextField @bind-Value="_model.Login" For="@(() => _model.Login)"
                      Label="Vendor code or e-mail" Variant="Variant.Outlined"
                      AutoFocus="true" Disabled="_busy" autocomplete="username" />
        <CaptchaField @ref="_captcha" @bind-Value="_model.Captcha" For="@(() => _model.Captcha)" Disabled="_busy" />
        <div class="mb-6"></div>
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                   Size="Size.Large" FullWidth="true" Disabled="_busy">
            @(_busy ? "Sending…" : "Send reset link")
        </MudButton>
    </EditForm>

    <div class="mt-4"><MudLink Href="/Account/Login?type=vendor" Typo="Typo.body2">Back to vendor sign-in</MudLink></div>
}

@code {
    private readonly ForgotModel _model = new();
    private CaptchaField? _captcha;
    private string _submittedLogin = "";
    private bool _busy;
    private bool _sent;
    private string? _error;

    private async Task SubmitAsync()
    {
        if (_busy)
            return;
        _busy = true;
        _error = null;

        // Stops scripts from mass-sending reset e-mails. The image is used up either way.
        var captchaOk = Captchas.Validate(_captcha?.ChallengeId, _model.Captcha);
        if (_captcha is not null)
            await _captcha.RefreshAsync();
        if (!captchaOk)
        {
            _error = "The security code didn't match. Type the characters in the new image.";
            _busy = false;
            return;
        }

        // Pad every request to the same minimum time, so "account exists" (which sends an
        // e-mail) isn't measurably slower than "no such account".
        var minimumDuration = Task.Delay(TimeSpan.FromSeconds(1));
        try
        {
            await Resets.RequestResetAsync(_model.Login);
            await minimumDuration;
            _submittedLogin = _model.Login.Trim();
            _sent = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Password reset request failed");
            await minimumDuration;
            _error = "We couldn't process the request right now. Please try again later.";
        }
        _busy = false;
    }

    private sealed class ForgotModel
    {
        [Required(ErrorMessage = "Enter your username or e-mail.")]
        [StringLength(256)]
        public string Login { get; set; } = "";

        [Required(ErrorMessage = "Enter the security code.")]
        [StringLength(CaptchaService.MaxLength)]
        public string Captcha { get; set; } = "";
    }
}
