@page "/Account/Login"
@layout Admin.Components.Layout.AuthLayout
@rendermode InteractiveServer
@attribute [AllowAnonymous]

@using System.ComponentModel.DataAnnotations
@using Admin.Auth
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using MudBlazor
@using static Microsoft.AspNetCore.Components.Web.RenderMode

@inject AccountService Accounts
@inject LoginTicketStore Tickets
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<Login> Logger
@implements IAsyncDisposable

<PageTitle>Sign in</PageTitle>

<div class="qps-eyebrow">Welcome back</div>
<h2 class="qps-title">Sign in to QPS</h2>
<p class="qps-sub">Use your Vishal Mega Mart account.</p>

@if (_notice is not null)
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">@_notice</MudAlert>
}
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4" role="alert">@_error</MudAlert>
}

<EditForm Model="_model" OnValidSubmit="SignInAsync">
    <DataAnnotationsValidator />

    <MudTextField @bind-Value="_model.Login" For="@(() => _model.Login)"
                  Label="Username or e-mail" Variant="Variant.Outlined" Class="mb-4"
                  AutoFocus="true" Disabled="_busy" autocomplete="username" />

    <MudTextField @bind-Value="_model.Password" For="@(() => _model.Password)"
                  Label="Password" Variant="Variant.Outlined"
                  InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                  Adornment="Adornment.End"
                  AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                  AdornmentAriaLabel="@(_showPassword ? "Hide password" : "Show password")"
                  OnAdornmentClick="() => _showPassword = !_showPassword"
                  Disabled="_busy" autocomplete="current-password" />

    <div class="d-flex align-center justify-space-between my-4">
        <MudCheckBox T="bool" @bind-Value="_model.RememberMe" Label="Keep me signed in" Disabled="_busy" />
        <MudLink Href="/Account/Forgot-Password" Typo="Typo.body2">Forgot password?</MudLink>
    </div>

    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
               Size="Size.Large" FullWidth="true" Disabled="_busy">
        @if (_busy)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            <span>Signing in…</span>
        }
        else
        {
            <span>Sign in</span>
        }
    </MudButton>
</EditForm>

@*
    Credentials were verified over the circuit. This form turns that into a real HTTP POST,
    whose response sets the auth cookie. It holds a one-time ticket, never the password.
*@
@if (_ticket is not null)
{
    <form id="@CompleteFormId" method="post" action="@AuthConstants.CompleteLoginEndpoint" hidden>
        <AntiforgeryToken />
        <input type="hidden" name="ticket" value="@_ticket" />
        <input type="hidden" name="returnUrl" value="@_returnUrl" />
    </form>
}

@code {
    private const string CompleteFormId = "login-complete";

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    [SupplyParameterFromQuery(Name = "ReturnUrl")] private string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "reason")] private string? Reason { get; set; }
    [SupplyParameterFromQuery(Name = "error")] private string? Error { get; set; }

    private readonly LoginModel _model = new();
    private string _returnUrl = "/";
    private string? _notice;
    private string? _error;
    private string? _ticket;
    private bool _busy;
    private bool _showPassword;
    private bool _submitPending;
    private IJSObjectReference? _module;

    protected override async Task OnInitializedAsync()
    {
        _returnUrl = UrlSafety.LocalOrRoot(ReturnUrl);

        if (AuthState is not null && (await AuthState).User.Identity?.IsAuthenticated == true)
        {
            Nav.NavigateTo(_returnUrl, replace: true);
            return;
        }

        _notice = Reason switch
        {
            "idle" => "You were signed out after a period of inactivity.",
            "signedout" => "You have been signed out.",
            "reset" => "Your password has been changed. Sign in with your new password.",
            _ => null,
        };
        if (Error == "expired")
            _error = "Sign-in took too long to complete. Please try again.";
    }

    private async Task SignInAsync()
    {
        if (_busy)
            return;
        _busy = true;
        _error = _notice = null;

        try
        {
            var result = await Accounts.ValidateCredentialsAsync(_model.Login, _model.Password);
            _model.Password = "";   // don't keep the password in circuit memory

            switch (result.Status)
            {
                case LoginStatus.Success:
                    _ticket = Tickets.Issue(result.User!.Id, _model.RememberMe);
                    _submitPending = true;   // posted in OnAfterRenderAsync; _busy stays on until the page reloads
                    return;
                case LoginStatus.LockedOut:
                    _error = "Too many failed attempts. Try again in a few minutes, or reset your password.";
                    break;
                case LoginStatus.Disabled:
                    _error = "Your account is disabled. Contact your administrator.";
                    break;
                default:
                    _error = "Invalid username or password.";   // same text for unknown user and wrong password
                    break;
            }
        }
        catch (Exception ex)
        {
            _model.Password = "";
            Logger.LogError(ex, "Sign-in failed unexpectedly");
            _error = "Something went wrong. Please try again.";
        }
        _busy = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_submitPending)
            return;
        _submitPending = false;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/auth.js");
        await _module.InvokeVoidAsync("submitForm", CompleteFormId);
    }

    public async ValueTask DisposeAsync()
    {
        try { if (_module is not null) await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Enter your username or e-mail.")]
        [StringLength(256)]
        public string Login { get; set; } = "";

        [Required(ErrorMessage = "Enter your password.")]
        [StringLength(PasswordPolicy.MaxLength)]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; }
    }
}
