@page "/Account/Reset-Password"
@layout Admin.Components.Layout.AuthLayout
@rendermode InteractiveServer
@attribute [AllowAnonymous]

@using System.ComponentModel.DataAnnotations
@using Admin.Auth
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Options
@using MudBlazor
@using static Microsoft.AspNetCore.Components.Web.RenderMode

@inject PasswordResetService Resets
@inject IOptions<AuthSettings> Settings
@inject NavigationManager Nav
@inject ILogger<ResetPassword> Logger

<PageTitle>Set a new password</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1">Set a new password</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="my-6" />
}
else if (!_tokenValid)
{
    <MudAlert Severity="Severity.Warning" Class="my-4">
        This reset link is invalid, has expired, or has already been used.
    </MudAlert>
    <MudLink Href="/Account/Forgot-Password">Request a new link</MudLink>
}
else
{
    <MudText Typo="Typo.body2" Class="mb-6 mud-text-secondary">
        Use at least @Settings.Value.MinPasswordLength characters. A short sentence is easy to remember and hard to guess.
    </MudText>

    @if (_errors.Count > 0)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4" role="alert">
            @foreach (var e in _errors) { <div>@e</div> }
        </MudAlert>
    }

    <EditForm Model="_model" OnValidSubmit="SubmitAsync">
        <DataAnnotationsValidator />
        <MudTextField @bind-Value="_model.NewPassword" For="@(() => _model.NewPassword)"
                      Label="New password" Variant="Variant.Outlined" Class="mb-4"
                      InputType="InputType.Password" Disabled="_busy" autocomplete="new-password" />
        <MudTextField @bind-Value="_model.ConfirmPassword" For="@(() => _model.ConfirmPassword)"
                      Label="Confirm new password" Variant="Variant.Outlined" Class="mb-6"
                      InputType="InputType.Password" Disabled="_busy" autocomplete="new-password" />
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                   Size="Size.Large" FullWidth="true" Disabled="_busy">
            @(_busy ? "Saving…" : "Change password")
        </MudButton>
    </EditForm>
}

@code {
    [SupplyParameterFromQuery(Name = "token")] private string? Token { get; set; }

    private readonly ResetModel _model = new();
    private List<string> _errors = [];
    private bool _loading = true;
    private bool _tokenValid;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _tokenValid = await Resets.IsTokenValidAsync(Token);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not check reset token");
        }
        _loading = false;
    }

    private async Task SubmitAsync()
    {
        if (_busy)
            return;
        _busy = true;
        _errors = [];

        try
        {
            var result = await Resets.ResetPasswordAsync(Token, _model.NewPassword);
            if (result.Succeeded)
            {
                // Full reload: the security stamp changed, so any old session is gone anyway.
                Nav.NavigateTo("/Account/Login?reason=reset", forceLoad: true);
                return;
            }
            if (result.InvalidToken)
                _tokenValid = false;
            _errors = [.. result.Errors];
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Password reset failed unexpectedly");
            _errors = ["Something went wrong. Please try again."];
        }
        _model.NewPassword = _model.ConfirmPassword = "";
        _busy = false;
    }

    private sealed class ResetModel
    {
        [Required(ErrorMessage = "Enter a new password.")]
        [StringLength(PasswordPolicy.MaxLength)]
        public string NewPassword { get; set; } = "";

        [Required(ErrorMessage = "Confirm the new password.")]
        [Compare(nameof(NewPassword), ErrorMessage = "The passwords don't match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
